CREATE DATABASE db;
USE db;

CREATE TABLE users (
   id u32,
   name varchar(255)
);

SELECT * FROM users WHERE id = 1;

INSERT INTO users VALUES (1, 'Alice');

SELECT * FROM users;

CREATE TABLE posts (
   id u32,
   content varchar(255),
   user_id u32
);

INSERT INTO posts VALUES (1, 'Hello World', 1);

DROP TABLE posts;
DROP DATABASE db;